# Copy to backend/.env (git-ignored) and adjust. Never commit real credentials.
AGRISENSE_ENVIRONMENT=development

# Database: SQLite by default (zero setup) ...
AGRISENSE_DATABASE_URL=sqlite:///./agrisense.db
# ... or PostgreSQL, e.g. a Neon serverless database (copy the URL from the Neon console):
# AGRISENSE_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require
# If the connection times out although the host is reachable, a firewall or ISP is probably
# blocking PostgreSQL's SSL start message; append &sslnegotiation=direct (Neon supports it).

# Simulation service
AGRISENSE_AUTOSTART=true
AGRISENSE_SIM_SPEED=60          # simulated seconds per real second (1 = real time)
AGRISENSE_SIM_STEP_S=5          # physics step, seconds (<= 10)
# AGRISENSE_SEED=42
# AGRISENSE_CONFIG_DIR=./my-greenhouse

# Storage
AGRISENSE_STATE_EVERY_S=60      # simulated seconds between stored snapshots
AGRISENSE_READINGS_EVERY_S=300
AGRISENSE_KEEP_RUNS=5           # older runs are deleted when a new run starts
AGRISENSE_RETAIN_DAYS=30        # simulated days of history kept per run (~5 MB per day)
AGRISENSE_FLUSH_EVERY_S=2       # real seconds between background writes

# Phase 4 models (default: the repository's ml/ folder)
# AGRISENSE_ML_DIR=../ml
