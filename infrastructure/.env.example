# Copy to infrastructure/.env (git-ignored). Docker Compose reads it automatically.

# Local PostgreSQL container (docker-compose.yml)
POSTGRES_USER=agrisense
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agrisense

# Simulation
AGRISENSE_SIM_SPEED=60

# URL of the API as seen by the browser (baked into the dashboard image)
PUBLIC_API_URL=http://localhost:8000

# Neon (docker-compose.neon.yml). Copy both from the Neon console, "Connection string":
#   pooled host (contains "-pooler") for the API, direct host (without "-pooler") for migrations.
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# NEON_MIGRATE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
