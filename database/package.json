{
  "name": "agrisense-database",
  "version": "0.1.0",
  "private": true,
  "description": "AgriSense PostgreSQL schema and migrations (Prisma Migrate)",
  "scripts": {
    "validate": "prisma validate",
    "format": "prisma format",
    "status": "prisma migrate status",
    "deploy": "prisma migrate deploy",
    "dev": "prisma migrate dev",
    "baseline": "prisma migrate resolve --applied 20261118000000_init",
    "check": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "studio": "prisma studio"
  },
  "devDependencies": {
    "dotenv": "17.4.2",
    "prisma": "7.10.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
